<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AmplitudeMauiPoc.App">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="Accent">#1E61F0</Color>
            <Color x:Key="TextPrimary">#1A1A2E</Color>
            <Color x:Key="TextSecondary">#555770</Color>
            <Color x:Key="SurfaceLight">#F4F4F8</Color>
            <Color x:Key="Success">#2E7D32</Color>
            <Color x:Key="Warning">#EF6C00</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
